{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "markito",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	// Custom domain (wrangler creates the DNS + cert on deploy). Protected by
	// Cloudflare Access — set up the Access app BEFORE the first deploy.
	"routes": [{ "pattern": "md2.example.com", "custom_domain": true }],
	// Folder config persists in KV (editable in the UI). An R2 "folder" is a
	// key prefix in the bound bucket.  Create once: wrangler kv namespace create CONFIG
	"kv_namespaces": [
		{
			"binding": "CONFIG",
			"id": "070adbb96e624abc86b860d697ab53ca"
		}
	],
	// One bound R2 bucket — no credentials needed.  wrangler r2 bucket create markito
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "markito"
		}
	]
}
