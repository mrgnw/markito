{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "markito",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-06-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	// Folder config persists in KV (editable in the UI). An R2 "folder" is a
	// key prefix in the bound bucket. Wrangler creates the namespace on first deploy.
	"kv_namespaces": [
		{
			"binding": "CONFIG"
		}
	],
	// One bound R2 bucket — no credentials needed.  wrangler r2 bucket create markito
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "markito"
		}
	]
}
