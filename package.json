{
	"name": "markito",
	"version": "0.1.0",
	"description": "Edit local markdown files in your browser. Run locally, add folders, edit.",
	"type": "module",
	"license": "MIT",
	"author": "Morgan Williams",
	"homepage": "https://github.com/mrgnw/markito#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mrgnw/markito.git"
	},
	"bugs": {
		"url": "https://github.com/mrgnw/markito/issues"
	},
	"keywords": [
		"markdown",
		"editor",
		"wysiwyg",
		"sveltekit",
		"cli",
		"cloudflare-workers"
	],
	"bin": {
		"markito": "bin/markito.js"
	},
	"files": [
		"build",
		"bin"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:cf": "ADAPTER=cloudflare vite build",
		"start": "node build",
		"preview": "vite preview",
		"ship": "ADAPTER=cloudflare vite build && wrangler deploy",
		"test": "bun scripts/test-buildtree.ts && bun scripts/test-config-store.ts && bun run test:roundtrip",
		"test:roundtrip": "vite build && uv run scripts/check-roundtrip.py",
		"prepare": "svelte-kit sync || echo ''",
		"prepublishOnly": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^26.0.1",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"wrangler": "^4.105.0"
	},
	"dependencies": {
		"@fontsource-variable/lora": "^5.3.0",
		"@fontsource-variable/martian-mono": "^5.3.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@voithos-labs/aragonite": "0.10.10"
	}
}
